# =============================================================================
# Investment Stock Application — Environment Template
# Copy to .env and fill secrets. .env is gitignored — never commit it.
#   cp .env.example .env   (Linux/macOS)  |  Copy-Item .env.example .env  (PowerShell)
# =============================================================================

# --- Database (Docker production MUST use absolute /app/data path) ---
# Inside Docker:  sqlite:////app/data/app.db  (host ./data mounted at /app/data)
# Local dev:     sqlite:///./data/app.db       (relative to repo root)
DATABASE_URL=sqlite:////app/data/app.db

# --- Runtime ---
ENVIRONMENT=production
# Leave empty to use same-origin /api proxy via Nginx (recommended).
# Set to https://api.example.com only if frontend and API are on different hosts.
VITE_API_BASE_URL=

# --- LLM (OpenRouter :free only, cached in llm_cache — never overwrites fundamentals) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_MODEL_FALLBACK=mistralai/mistral-small-24b-instruct-2501:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- SEC EDGAR (required header per SEC fair-access policy) ---
SEC_USER_AGENT=StockAnalysisApp contact@localhost

# --- Background Jobs ---
JOBS_WORKER_DISABLED=0
REFRESH_ENABLED=0
REFRESH_INTERVAL_HOURS=168
